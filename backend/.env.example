# Copy to backend/.env for local development. backend/.env is git-ignored.
# Real environment variables take precedence over values in this file.

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/german_reader
DB_USERNAME=german_reader
DB_PASSWORD=change-me

# --- CORS (comma-separated list of frontend origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Translation provider: mock | gemini ---
TRANSLATION_PROVIDER=mock

# --- Gemini (required only when TRANSLATION_PROVIDER=gemini) ---
# Create a key at https://aistudio.google.com/apikey. Never commit a real key.
GEMINI_API_KEY=
# Any Gemini model that supports structured JSON output, e.g. a current free-tier Flash model.
GEMINI_MODEL=
# Optional request timeout (ISO-8601 or Spring duration format, e.g. 15s)
# GEMINI_TIMEOUT=15s
