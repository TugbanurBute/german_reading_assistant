# Production template: copy to .env on the server and fill in. Placeholders only, never commit real values.
# Secrets: letters and digits only (Compose and Spring would interpret $ and ${...}).

# Makes plain `docker compose ...` (and scripts/backup-db.sh) use the production file.
COMPOSE_FILE=docker-compose.prod.yml

PUBLIC_ORIGIN=https://germanreader.duckdns.org
# Loopback port the host's HTTPS proxy forwards to; must not be used by another stack.
FRONTEND_PORT=8090

POSTGRES_DB=german_reader
POSTGRES_USER=german_reader
POSTGRES_PASSWORD=

RABBITMQ_USERNAME=german_reader
RABBITMQ_PASSWORD=

# At least 32 characters, e.g. openssl rand -hex 32
JWT_SECRET=

# gemini or mock
TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional (defaults shown)
ANALYTICS_TIME_ZONE=UTC
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=5m
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=1h
TRANSLATION_DAILY_LIMIT=200
GEMINI_DAILY_CALL_LIMIT=500
